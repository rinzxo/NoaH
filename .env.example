# Konfigurasi Bot
BOT_NAME="Private Asisten"
# Nomor WhatsApp Anda (Owner), contoh: 628123456789 (tanpa tanda + atau spasi)
OWNER_NUMBER="628123456789"

# Mode Autentikasi: qr atau pairing (disarankan pairing jika di VPS tanpa layar)
AUTH_MODE="qr"
# Nomor yang akan di-pair jika AUTH_MODE=pairing
PAIRING_NUMBER="628123456789"

# Google Gemini AI (Opsional: untuk asisten percakapan cerdas & deteksi jadwal otomatis)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Twilio Voice API (Opsional: untuk panggilan telepon keluar ke nomor HP)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
